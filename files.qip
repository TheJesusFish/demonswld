set_global_assignment -name SDC_FILE Arcade-DemonsWorld.sdc
set_global_assignment -name SYSTEMVERILOG_FILE Arcade-DemonsWorld.sv

set_global_assignment -name QIP_FILE rtl/game.qip
set_global_assignment -name QIP_FILE rtl/demonwld/TMS320C1X/TMS320C1X.qip

set_global_assignment -name VERILOG_FILE rtl/demonwld/video_timing.v
set_global_assignment -name VERILOG_FILE rtl/demonwld/pause.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/demonwld/chip_select.v

set_global_assignment -name VERILOG_FILE rtl/demonwld/mem/rom_controller.v
set_global_assignment -name VERILOG_FILE rtl/demonwld/mem/tile_cache.v
set_global_assignment -name VERILOG_FILE rtl/demonwld/mem/cache.v
set_global_assignment -name VHDL_FILE rtl/demonwld/mem/math.vhd
set_global_assignment -name VHDL_FILE rtl/demonwld/mem/segment.vhd
set_global_assignment -name VHDL_FILE rtl/demonwld/mem/download_buffer.vhd
set_global_assignment -name VHDL_FILE rtl/demonwld/mem/sdram.vhd
set_global_assignment -name VHDL_FILE rtl/demonwld/mem/dual_port_ram.vhd

# Resolve bare ROM/table init names from drop-in module folders.
set_global_assignment -name SEARCH_PATH rtl/modules/fx68k
set_global_assignment -name SEARCH_PATH rtl/demonwld/TMS320C1X
